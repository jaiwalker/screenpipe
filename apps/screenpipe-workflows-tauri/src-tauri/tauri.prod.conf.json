{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenpipe Workflows",
  "identifier": "screenpi.pe.workflows",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:1430"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "publisher": "Mediar, Inc.",
    "category": "DeveloperTool",
    "shortDescription": "Turn repeated work into supervised agents",
    "longDescription": "Screenpipe Workflows learns repeated work from local desktop context, then helps you review, test, and supervise agents.",
    "copyright": "",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-black.png"
    ],
    "resources": [
      "assets/*",
      "PermissionFlow_PermissionFlow.bundle"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File sign-ssl.ps1 %1"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "screenpipe-workflows"
        ]
      },
      "mobile": [
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/auth"
          ]
        },
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/stripe-connect"
          ]
        },
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/purchase-successful"
          ]
        },
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/settings"
          ]
        },
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/changelog"
          ]
        },
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/onboarding"
          ]
        },
        {
          "host": "screenpipe.com",
          "pathPrefix": [
            "/status"
          ]
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_workflows_main",
      "iconPath": "assets/screenpipe-logo-tray-white.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.screenpipe/**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
